# Copy to .env and adjust for your machine. Each script sources .env if present.

# scripts/start_ms.sh — the MuseScore binary to launch with logging.
MUSE_SCORE_FOLDER="/Applications/MuseScore 4.app/Contents/MacOS/mscore"

# scripts/sync.sh / sync-harness.sh — where the JazzKit *extension* bundle is
# deployed (MU4.4+ extensions live here, NOT in Plugins/).
EXTENSIONS_FOLDER="~/Library/Application Support/MuseScore/MuseScore4/extensions"
